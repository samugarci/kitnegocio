# Stripe - Obtén tus claves en https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# URL base de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email de soporte
NEXT_PUBLIC_SUPPORT_EMAIL=soporte@kitnegocio.com

# Auth local (firma de cookies de sesión). Cambia esto en producción.
AUTH_SECRET=cambia-este-secreto-largo-y-aleatorio

# Emails autorizados como superadministrador (separados por coma)
SUPER_ADMIN_EMAILS=tu-email@ejemplo.com

# Supabase (https://supabase.com → Project Settings → API)
# 1. Crea un proyecto gratuito
# 2. Ejecuta supabase/migrations/001_auth_profiles.sql en SQL Editor
# 3. Pega URL y claves aquí (sin comillas)
# Mientras uses placeholders, la app usa almacenamiento local cifrado en /data
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
